# ------------------------------------------------------------
# 1. FRONTEND / CLIENT CONFIGURATION (Vite)
# Lưu ý: Các biến bắt đầu bằng VITE_ sẽ được đóng gói ra trình duyệt.
# Tuyệt đối KHÔNG đặt Service Role Key hoặc Private Key ở đây.
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://xcednxnkywsnipjonkcu.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_6z-Fmt1uOK3UdanzJ-mqkA_VA5jRH53

# Hỗ trợ tương thích ngược cho cả định dạng NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_URL=https://xcednxnkywsnipjonkcu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_6z-Fmt1uOK3UdanzJ-mqkA_VA5jRH53

# Khóa công khai VAPID cho Web Push Notification trên trình duyệt (Tùy chọn)
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ------------------------------------------------------------
